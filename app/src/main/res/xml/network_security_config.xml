<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0.0: 全面禁止明文 HTTP 流量，百度已支持 HTTPS，移除历史例外 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
