<?xml version="1.0" encoding="utf-8"?>
<!--
    v2.0.0 安全加固：完全禁止备份与设备迁移。
    密码管理器场景下，allowBackup=true 会让 adb backup 导出加密后的密码字段，
    存在离线爆破风险。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
